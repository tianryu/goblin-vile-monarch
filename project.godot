; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="我是哥布林：君主"
config/icon="res://game/art/runtime/app_icon.png"
boot_splash/image="res://game/art/runtime/app_icon.png"
boot_splash/bg_color=Color(0.12, 0.17, 0.15, 1)
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=480
window/size/window_width_override=1152
window/size/window_height_override=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.15, 1)

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
